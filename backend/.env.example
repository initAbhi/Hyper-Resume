# ==============================================================================
# HyperResume — Backend Environment Configuration Example
# Copy this file to .env and populate with your local values.
# NEVER commit the actual .env file to version control.
# ==============================================================================

# Application Runtime
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000
# Comma-separated list of additional allowed CORS origins (e.g. preview deployments, staging domains)
ADDITIONAL_CORS_ORIGINS=https://staging.hype-resume.com,https://preview.hype-resume.com

# Database Configuration (PostgreSQL)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=hyper_resume_db
DATABASE_USER=postgres
DATABASE_PASSWORD=your_local_postgres_password_here

# Isolated Test Database Configuration (Used for integration test runs)
TEST_DATABASE_NAME=hyper_resume_test_db

# Authentication & Security
JWT_SECRET=your_secure_jwt_secret_min_32_characters_here
JWT_EXPIRATION=7d

# File Storage Configuration (Local filesystem or S3-compatible object storage)
STORAGE_DRIVER=local # local | s3
STORAGE_LOCAL_PATH=./uploads
S3_BUCKET_NAME=hyper-resume-uploads
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=your_s3_access_key
S3_SECRET_ACCESS_KEY=your_s3_secret_key

# Vector PDF Rendering (Headless Chromium / Puppeteer)
# In Linux / Docker, install Chromium (e.g. `apt-get install -y chromium`) and set path below:
CHROME_PATH=/usr/bin/chromium # /usr/bin/google-chrome-stable | /usr/bin/chromium | C:\Program Files\Google\Chrome\Application\chrome.exe
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# AI Provider Configuration (Structured LLM extraction & bullet optimization)
AI_PROVIDER=gemini # gemini | openai | anthropic
AI_API_KEY=your_ai_api_key_here
AI_MODEL=gemini-2.5-flash # gemini-2.5-flash | gemini-1.5-flash | gemini-3.1-flash-lite | gemini-2.0-flash | gemini-3.5-flash

# Payment Gateway Configuration (Primary: Dodo Payments | Optional: Razorpay)
PAYMENT_PROVIDER=dodo # dodo | razorpay | sandbox
DODO_PAYMENTS_ENVIRONMENT=test_mode # test_mode | live_mode
DODO_PAYMENTS_TEST_API_KEY=your_dodo_test_api_key
DODO_PAYMENTS_TEST_WEBHOOK_KEY=your_dodo_test_webhook_secret
DODO_PAYMENTS_LIVE_API_KEY=your_dodo_live_api_key
DODO_PAYMENTS_LIVE_WEBHOOK_KEY=your_dodo_live_webhook_secret
DODO_PRODUCT_ID_PRO_WEEKLY=pdt_your_test_weekly_product_id
DODO_PRODUCT_ID_PRO_MONTHLY=pdt_your_test_monthly_product_id
DODO_PRODUCT_ID_PRO_6MONTH=pdt_your_test_6month_product_id
DODO_PRODUCT_ID_PRO_LIFETIME=pdt_your_test_lifetime_product_id
DODO_LIVE_PRODUCT_ID_PRO_WEEKLY=pdt_your_live_weekly_product_id
DODO_LIVE_PRODUCT_ID_PRO_MONTHLY=pdt_your_live_monthly_product_id
DODO_LIVE_PRODUCT_ID_PRO_6MONTH=pdt_your_live_6month_product_id
DODO_LIVE_PRODUCT_ID_PRO_LIFETIME=pdt_your_live_lifetime_product_id
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Meta Conversions API (Server-side CAPI tracking)
META_PIXEL_ID=your_meta_pixel_id
META_CONVERSIONS_API_ACCESS_TOKEN=your_meta_capi_token

# Transactional Email Configuration (Verification, alerts, notifications)
EMAIL_PROVIDER=smtp # smtp | resend
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
EMAIL_FROM="HyperResume <support@hyperresume.ai>"

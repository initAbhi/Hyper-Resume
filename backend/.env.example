# ==============================================================================
# HyperResume — Backend Environment Configuration Example
# Copy this file to .env and populate with your local values.
# NEVER commit the actual .env file to version control.
# ==============================================================================

# Application Runtime
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# Database Configuration (PostgreSQL)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=hyper_resume_db
DATABASE_USER=postgres
DATABASE_PASSWORD=your_local_postgres_password_here

# Isolated Test Database Configuration (Used for integration test runs)
TEST_DATABASE_NAME=hyper_resume_test_db

# Authentication & Security
JWT_SECRET=your_secure_jwt_secret_min_32_characters_here
JWT_EXPIRATION=7d

# File Storage Configuration (Local filesystem or S3-compatible object storage)
STORAGE_DRIVER=local # local | s3
STORAGE_LOCAL_PATH=./uploads
S3_BUCKET_NAME=hyper-resume-uploads
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=your_s3_access_key
S3_SECRET_ACCESS_KEY=your_s3_secret_key

# AI Provider Configuration (Structured LLM extraction & bullet optimization)
AI_PROVIDER=gemini # gemini | openai | anthropic
AI_API_KEY=your_ai_api_key_here
AI_MODEL=gemini-1.5-flash

# Payment Gateway Configuration (India-compatible: Razorpay / Stripe)
PAYMENT_PROVIDER=razorpay # razorpay | stripe
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Transactional Email Configuration (Verification, alerts, notifications)
EMAIL_PROVIDER=smtp # smtp | resend
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
EMAIL_FROM="HyperResume <support@hyperresume.ai>"

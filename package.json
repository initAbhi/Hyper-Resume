{
  "name": "hyper-resume-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "HyperResume — AI Job-Application Optimization Platform",
  "scripts": {
    "dev:backend": "bun --cwd backend start:dev",
    "dev:frontend": "bun --cwd frontend dev",
    "build:backend": "bun --cwd backend build",
    "build:frontend": "bun --cwd frontend build",
    "build": "bun run build:backend && bun run build:frontend",
    "lint:backend": "bun --cwd backend lint",
    "lint:frontend": "bun --cwd frontend lint",
    "lint": "bun run lint:backend && bun run lint:frontend",
    "typecheck:backend": "bun --cwd backend typecheck",
    "typecheck:frontend": "bun --cwd frontend typecheck",
    "typecheck": "bun run typecheck:backend && bun run typecheck:frontend",
    "test:backend": "bun --cwd backend test",
    "test:frontend": "bun --cwd frontend test",
    "test:e2e": "bun --cwd backend test:e2e",
    "test": "bun run test:backend && bun run test:frontend && bun run test:e2e",
    "db:migrate": "bun --cwd backend migration:run",
    "db:status": "bun --cwd backend migration:show",
    "db:revert": "bun --cwd backend migration:revert",
    "db:generate": "bun --cwd backend migration:generate"
  },
  "packageManager": "bun@1.3.2",
  "engines": {
    "node": ">=20.0.0",
    "bun": ">=1.3.0"
  }
}
